{
  "name": "wagering-processor",
  "version": "1.0.0",
  "private": true,
  "description": "Distributed Wagering Processor — Jungle Gaming technical challenge",
  "scripts": {
    "start": "bun run src/main.ts",
    "start:dev": "bun --watch run src/main.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "migrate:up": "bun run src/infrastructure/persistence/migrate.ts up",
    "migrate:down": "bun run src/infrastructure/persistence/migrate.ts down",
    "migrate:status": "bun run src/infrastructure/persistence/migrate.ts status",
    "test": "bun test",
    "test:unit": "bun test test/unit",
    "test:integration": "bun test --timeout 60000 test/integration",
    "test:concurrency": "bun test --timeout 120000 test/concurrency",
    "test:all": "bun test --timeout 120000",
    "test:load": "bun run test/load/load-test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "3.1160.0",
    "@mikro-orm/core": "6.6.17",
    "@mikro-orm/migrations": "6.6.17",
    "@mikro-orm/postgresql": "6.6.17",
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "decimal.js": "10.6.0",
    "pino": "10.4.0",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/express": "5.0.3",
    "typescript": "5.9.3"
  }
}
